{
  "name": "stockwise",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.js",
    "test:security": "node scripts/check-growth-security.mjs",
    "test:browser:social": "node tests/social-metrics.browser.mjs",
    "test:browser:automation": "node tests/social-automation.browser.mjs",
    "buffer:read": "node --use-env-proxy scripts/buffer-growth-read.mjs",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "test:browser:main": "node tests/main-integration.browser.mjs",
    "test:sales": "node --test tests/sales-*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.8"
  }
}

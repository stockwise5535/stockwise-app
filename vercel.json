{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/managed-service-mvp": false,
      "codex/integrate-social-autopilot-main": false
    }
  },
  "crons": [
    {
      "path": "/api/internal/social-metrics-sync",
      "schedule": "50 8 * * *"
    }
  ]
}
